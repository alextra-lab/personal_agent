# Caddyfile for Cloud Simulation
#
# Routes:
#   /api/*             → seshat-gateway:9001  (REST API)
#   /chat, /chat/stream, /ws/*     → seshat-gateway:9001  (AG-UI endpoints)
#   /docs, /openapi.json, /redoc → seshat-gateway:9001 (Swagger)
#   /*                 → seshat-pwa:3000      (Next.js PWA)
#
# The site block below shares the same routing — HTTPS for SSH tunnel access.

{
	local_certs
	admin 0.0.0.0:2019
}

# Shared routing — gateway handles API paths, PWA handles everything else
(routing) {
	@backend path /api/* /chat /chat/stream /ws/* /docs /docs/* /openapi.json /redoc
	handle @backend {
		reverse_proxy seshat-gateway:9001 {
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto {http.request.proto}
			header_up X-Forwarded-Host {http.request.header.Host}
		}
	}
	handle {
		reverse_proxy seshat-pwa:3000
	}
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format json
	}
	handle_errors {
		@4xx expression `{http.error.status_code} >= 400 && {http.error.status_code} < 500`
		@5xx expression `{http.error.status_code} >= 500`
		respond @4xx "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
		respond @5xx "Internal Server Error" 500
	}
}

# HTTPS — SSH tunnel dev access (curl -k https://localhost/...)
localhost {
	import routing
}

# Cloudflare Tunnel — user-facing PWA + same-origin API
# Traffic arrives from cloudflared with Host: {$AGENT_HOST} (real value from .env; FRE-895).
# Uses the shared routing snippet: /api/* → seshat-gateway:9001, /* → seshat-pwa:3000.
# :80 port suffix disables Caddy auto-HTTPS (http:// prefix alone is insufficient with local_certs).
# WARP-enrolled devices reach this same hostname block (FRE-1244) — no separate private-network
# IP route; a publicly tunneled hostname needs no raw-CIDR routing to be reachable from WARP.
{$AGENT_HOST:agent.example.com}:80 {
	@ws path /ws/*
	handle @ws {
		reverse_proxy seshat-gateway:9001
	}
	import routing
}

# Cloudflare Tunnel — Neo4j Browser UI + Bolt WebSocket
# {$GRAPH_HOST} (real value from .env; FRE-895) → http://caddy:80 (Cloudflare Tunnel Terraform)
# TLS is terminated at the Cloudflare edge; traffic arrives here as plain HTTP.
#
# Bolt-over-WebSocket uses a WebSocket upgrade on the same HTTPS port (443).
# The Browser JS driver (running in the user's browser) connects to:
#   wss://{$GRAPH_HOST}  →  Cloudflare  →  caddy:80
# Caddy then splits:
#   WebSocket upgrade  →  neo4j:7687  (Bolt)
#   Regular HTTP       →  neo4j:7474  (Browser UI + REST API)
{$GRAPH_HOST:graph.example.com}:80 {
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy neo4j:7687
	}
	handle {
		reverse_proxy neo4j:7474
	}
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format json
	}
}

# Cloudflare Tunnel — Elasticsearch write endpoint for slm_server telemetry (FRE-411).
# slm_server (Mac) posts request_complete docs to {$ES_HOST} (real value from .env;
# FRE-895); the join with harness logs happens in ES on span_id / trace_id.
# Path-allowlisted to slm-requests-* indices only so a leaked CF Access token can't
# touch other indices. Full ES Security (native auth / API keys) is the planned
# follow-up; this is the interim CF-only gate.
http://{$ES_HOST:es.example.com}:80 {
	@allowed path_regexp ^/(slm-requests-[^/]+|_bulk)(/.*)?$
	handle @allowed {
		reverse_proxy elasticsearch:9200
	}
	respond "Forbidden" 403
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format json
	}
}

# Cloudflare Tunnel — OTLP ingress for the Mac-local OTel Collector (FRE-1224), the VPS half
# of FRE-1223 (FRE-1239). The Mac Collector posts spans to {$OTLP_HOST} (real value from .env;
# FRE-895) behind Cloudflare Access; cloudflared forwards to this listener from the cloud-sim
# compose network. HTTP only, never gRPC — the Cloudflare zone gRPC toggle stays off (ADR-0136).
# Path-allowlisted to the exact traces path, POST only, no query string — in the FRE-411 style,
# so a leaked Access token can only inject traces on one path. remote_ip restricts to the
# compose network (docker-compose.cloud.yml's own cloud-sim subnet) cloudflared runs on, so a
# request straight to the VPS IP with a forged Host header is refused even before the path
# check. request_body caps a single request so an oversized POST can't exhaust the Collector.
# The access log redacts the Cloudflare Access credential headers so this hop's evidence trail
# (ADR-0132 D3) never carries a bearer credential into caddy-access-*.
http://{$OTLP_HOST:otlp.example.com}:80 {
	@allowed {
		method POST
		path_regexp ^/v1/traces$
		query ""
		remote_ip 172.25.0.0/16
	}
	handle @allowed {
		request_body {
			max_size 20MiB
		}
		reverse_proxy otel-collector:4318
	}
	respond "Forbidden" 403
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format filter {
			request>headers>Cf-Access-Jwt-Assertion delete
			request>headers>Cf-Access-Client-Id delete
			request>headers>Cf-Access-Client-Secret delete
			wrap json
		}
	}
}

# Cloudflare Tunnel — external agent API access
# All paths route directly to the gateway.
# TLS is terminated at the Cloudflare edge; traffic arrives here as plain HTTP.
# :80 port suffix disables Caddy auto-HTTPS.
{$API_HOST:api.example.com}:80 {
	reverse_proxy seshat-gateway:9001 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {http.request.header.Host}
		transport http {
			dial_timeout 30s
			response_header_timeout 60s
		}
	}
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format json
	}
	handle_errors {
		@4xx expression `{http.error.status_code} >= 400 && {http.error.status_code} < 500`
		@5xx expression `{http.error.status_code} >= 500`
		respond @4xx "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
		respond @5xx "Internal Server Error" 500
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# OUTBOUND EGRESS BLOCKS (ADR-0132 D1, FRE-1144)
#
# Every block above is INBOUND: external traffic -> an internal service. The two
# below are OUTBOUND: the application dials them on the compose network and
# Caddy attaches the Cloudflare Access service token on the way out, so no
# outbound CF credential is resident in the gateway process.
#
# The credential comes from the caddy service's own env file
# (/opt/seshat/.env.caddy), which the gateway's blanket env_file does NOT
# import. Both listeners are reachable from the cloud-sim network and, via a
# LOOPBACK-ONLY port binding, from the VPS host — the latter so host-side eval
# tooling keeps a route to the SLM now that it holds no CF credential of its
# own. Neither is exposed off-box.
#
# A bare :port site address serves plain HTTP: `local_certs` in the global block
# only applies to addresses carrying a hostname.
# ─────────────────────────────────────────────────────────────────────────────

# Mac SLM tunnel — the VPS's path to the local models. Streaming-critical.
:8600 {
	# Path-scoped in the FRE-411 style (ADR-0132 D1): the inference surface plus
	# the health endpoint, nothing else. Anything that reaches this listener can
	# only spend the credential on the calls the application actually makes.
	@allowed path_regexp ^/(health|v1/(chat/completions|models|embeddings|rerank))$
	handle @allowed {
		reverse_proxy https://{$SLM_HOST:slm.example.com} {
			header_up CF-Access-Client-Id {$CF_ACCESS_CLIENT_ID}
			header_up CF-Access-Client-Secret {$CF_ACCESS_CLIENT_SECRET}
			# Upstream is a public CF-fronted host: Host must name it, not the
			# internal address the application dialled.
			header_up Host {$SLM_HOST:slm.example.com}
			# The OpenAI SDK's default User-Agent is WAF-blocked at the edge. That is
			# a Cloudflare-topology concern, so the override lives here rather than
			# in the embedding/inference clients (ADR-0132 D1).
			header_up User-Agent "seshat-gateway/1.0"

			transport http {
				# Fail fast on a dead tunnel.
				dial_timeout 10s
				# Time-to-first-header only. This CANNOT sever a stream that has
				# begun — see the load-bearing omissions below.
				response_header_timeout 60s
				# Pinned explicitly so connection reuse survives later edits to this
				# block rather than silently inheriting a changed default.
				keepalive 90s
				keepalive_idle_conns 8
			}

			# LOAD-BEARING OMISSION 1 — no `flush_interval`.
			# Caddy auto-flushes when the response Content-Type is text/event-stream
			# or the content length is unknown, which SSE inference responses are.
			# Forcing `-1` is unnecessary for SSE AND has a documented side effect:
			# it prevents Caddy cancelling the upstream request when the downstream
			# client disconnects, orphaning long generations and burning Mac-side
			# compute for an abandoned turn.
			#
			# LOAD-BEARING OMISSION 2 — no body-duration / idle timeout.
			# A real turn has been observed running 417 seconds. Caddy's HTTP
			# transport imposes no overall response timeout by default; adding one
			# here would sever long generations mid-stream.
			#
			# Do not "tidy" either omission in. Both are decisions, not oversights.
		}
	}
	respond "Forbidden" 403
	log egress_slm {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format json
	}
}

# Artifacts origin — the artifacts Worker / /lib/ shelf / served artifact URLs.
# Unlike the SLM block this carries no streaming constraint; requests are short
# asset fetches and header-only envelope probes.
:8601 {
	# Path-scoped in the FRE-411 style (ADR-0132 D1), and load-bearing here: an
	# unscoped listener would let anything that reaches it read EVERY user's
	# artifacts with the Access barrier bypassed. Restricted to the two shapes
	# the application actually fetches — a served artifact (UUID) and the /lib/
	# asset shelf.
	@allowed path_regexp ^/(lib/.+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$
	handle @allowed {
		reverse_proxy https://{$ARTIFACTS_HOST:artifacts.example.com} {
			header_up CF-Access-Client-Id {$CF_ACCESS_CLIENT_ID}
			header_up CF-Access-Client-Secret {$CF_ACCESS_CLIENT_SECRET}
			header_up Host {$ARTIFACTS_HOST:artifacts.example.com}

			transport http {
				dial_timeout 10s
				response_header_timeout 30s
				keepalive 90s
			}
		}
	}
	respond "Forbidden" 403
	log egress_artifacts {
		output file /var/log/caddy/access.log {
			mode 644
			roll_uncompressed
		}
		format json
	}
}
