      "targets": [
        {
          "dataset": "personal_agent",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-ledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (bc.role, bc.time_window) bc.role || ' (' || bc.time_window || ')' AS role, bc.running_total / NULLIF(bp.cap_usd, 0) AS utilization FROM budget_counters bc JOIN budget_policies bp ON bp.role = bc.role AND bp.time_window = bc.time_window AND bp.user_id IS NULL AND bp.provider IS NULL WHERE bc.user_id IS NULL AND bc.provider IS NULL ORDER BY bc.role, bc.time_window, bc.window_start DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Budget utilisation by role",
      "type": "bargauge"
    },
