      "pluginVersion": "13.1.3",
      "targets": [
        {
          "alias": "",
          "bucketAggs": [
            {
              "id": "2",
              "settings": {
                "filters": [
                  {
                    "label": "uncitable",
                    "query": "turn_evidence_class:uncitable"
                  },
                  {
                    "label": "total_asserting",
                    "query": "turn_evidence_class:uncitable OR turn_evidence_class:citable"
                  }
                ]
              },
              "type": "filters"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "editorType": "builder",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "preserveQuery": false,
          "query": "event_type:grounding_verification_completed",
          "queryType": "lucene",
          "refId": "A"
        }
      ],
      "title": "Uncitable Turn Rate",
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "uncitable_turn_rate",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "uncitable"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "total_asserting"
                }
              }
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            },
            "replaceFields": true
          }
        }
      ],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "description": "Citation-shaped strings that failed CITATION_MARKER_PATTERN and remain unresolved (ADR-0139 D1/D7). This family is CONDITIONAL, per ADR-0134 D1: silence is health, and it carries no alert or stoppage rule -- the coloring below is informational only, not an alert boundary.",
