{
  "uid": "fre1072-task-analytics",
  "title": "Task Analytics",
  "tags": [
    "fre-1072",
    "rebuilt-from-kibana"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Entity creation rate",
      "description": "Count of entity_created events over time (90d, full history -- 6585 entities total).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "query": "event_type: \"entity_created\"",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "date_histogram",
              "id": "1",
              "field": "@timestamp",
              "settings": {
                "interval": "1h"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Entity type breakdown",
      "description": "Count of entity_created events by entity_type (90d, full history -- 6585 entities across 7 types). Answers the \"types\" half of the decision this dashboard must enable; the original dashboard had no type breakdown at all.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "query": "event_type: \"entity_created\"",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "1",
              "field": "entity_type",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tasks over time",
      "description": "task_started vs task_completed events over time (90d, full history). See the Task completion rate panel: 1576 started vs 1149 completed, a ~27% gap.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "query": "event_type: (\"task_started\" or \"task_completed\")",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "1",
              "field": "event_type",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "1h"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Task completion rate",
      "description": "task_started vs task_completed totals (90d, full history). 1576 started vs 1149 completed -- a 427-turn (27.1%) gap between the two events. This could reflect abandoned/still-in-flight turns, an error path that skips task_completed, or an instrumentation gap; not investigated further here, flagged for a future observability pass.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "query": "event_type: (\"task_started\" or \"task_completed\")",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "1",
              "field": "event_type",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory enrichment activity",
      "description": "memory_query_completed vs memory_enrichment_completed events over time (90d, full history -- 344 queries, 1240 enrichments). Adjacent to the entity/task volume story: shows how much memory-recall work backs each turn.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "query": "event_type: (\"memory_query_completed\" or \"memory_enrichment_completed\")",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "1",
              "field": "event_type",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "1h"
              }
            }
          ],
          "timeField": "@timestamp"
        }
      ]
    }
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  }
}
