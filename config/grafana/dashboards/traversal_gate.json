{
  "uid": "fre1072-traversal-ledger-gate-decisions",
  "title": "Traversal Ledger & Gate Decisions",
  "tags": [
    "fre-1072",
    "rebuilt-from-kibana"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Gate decisions over time",
      "description": "Count of tool_loop_gate decisions (allow/warn_consecutive/block_consecutive) over time. Caveat: ~12.6% of tool_loop_gate docs are missing the decision field entirely due to the ES index.mapping.total_fields.limit=300 ceiling silently dropping new fields once a day's mapping is full (affected dates include 2026-06-17, 06-21, 06-26, 06-28, 06-29) -- undercount, not zero-signal.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-agent-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-agent-logs"
          },
          "query": "event_type: \"tool_loop_gate\"",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "id": "1",
              "field": "decision",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_count"
              }
            },
            {
              "type": "date_histogram",
              "id": "2",
              "field": "@timestamp",
              "settings": {
                "interval": "1h"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Gate decision outcomes",
      "description": "Total tool_loop_gate decisions by outcome (30d). Caveat: ~12.6% of tool_loop_gate docs are missing the decision field entirely due to the ES index.mapping.total_fields.limit=300 ceiling silently dropping new fields once a day's mapping is full (affected dates include 2026-06-17, 06-21, 06-26, 06-28, 06-29) -- verified counts undercount the true total by design, not a computation error.",
      "gridPos": {
        "h": 8,
        "w": 12,
