      "targets": [
        {
          "dataset": "personal_agent",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-ledger"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH costs AS (\n  SELECT session_id, SUM(cost_usd) AS total_cost_usd, COUNT(*) AS llm_calls\n  FROM api_costs\n  WHERE $__timeFilter(timestamp) AND session_id IS NOT NULL\n  GROUP BY session_id\n),\ntraces AS (\n  SELECT session_id, COUNT(DISTINCT trace_id) AS turns, AVG(latency_total_ms) AS avg_latency_ms\n  FROM route_traces\n  WHERE $__timeFilter(created_at) AND session_id IS NOT NULL\n  GROUP BY session_id\n),\narts AS (\n  SELECT session_id, COUNT(*) AS artifacts\n  FROM artifacts\n  WHERE $__timeFilter(created_at) AND session_id IS NOT NULL\n  GROUP BY session_id\n)\nSELECT COALESCE(costs.session_id, traces.session_id, arts.session_id) AS session_id,\n       COALESCE(costs.total_cost_usd, 0) AS total_cost_usd,\n       COALESCE(costs.llm_calls, 0) AS llm_calls,\n       COALESCE(traces.turns, 0) AS turns,\n       COALESCE(arts.artifacts, 0) AS artifacts\nFROM costs\nFULL OUTER JOIN traces ON traces.session_id = costs.session_id\nFULL OUTER JOIN arts ON arts.session_id = COALESCE(costs.session_id, traces.session_id)\nORDER BY total_cost_usd DESC\nLIMIT 15",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Session activity: cost, turns, calls, artifacts",
      "type": "barchart"
    },
