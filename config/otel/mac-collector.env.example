# Mac-local OTel Collector credentials (FRE-1224) — EXAMPLE ONLY.
#
# Copy to ~/.config/seshat/otlp-collector.env and chmod 600 it. That path is outside the repo on
# purpose: this file is committed, the real one must never be.
#
#   mkdir -p ~/.config/seshat
#   cp config/otel/mac-collector.env.example ~/.config/seshat/otlp-collector.env
#   chmod 600 ~/.config/seshat/otlp-collector.env
#
# scripts/mac/otelcol_launch.sh refuses to start if any of the three is unset or empty, rather
# than exporting spans with a blank Cloudflare Access header.

# Base URL of the OTLP ingress. NO trailing slash and NO path — the exporter appends /v1/traces
# itself, which is what matches FRE-1239's Caddy allowlist (POST, ^/v1/traces$, empty query).
# The real hostname is deployment identity and is never committed (FRE-895).
SESHAT_OTLP_INGRESS_URL=https://otlp.example.com

# The Cloudflare Access service token for the OTLP ingress application.
#
# This must be a DEDICATED token for that application — explicitly NOT the ADR-0132 D1 egress
# pair, which authenticates the VPS to the slm and artifact origins. Reusing that pair would
# couple three unrelated blast radii and place an egress credential on a third machine.
SESHAT_OTLP_CF_ACCESS_CLIENT_ID=replace-me.access
SESHAT_OTLP_CF_ACCESS_CLIENT_SECRET=replace-me
