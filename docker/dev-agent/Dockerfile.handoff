# Handoff image (ADR-0159 D8.8; FRE-1682). Git only. It writes a git bundle of the agent's
# branch out of an untrusted workspace, with hooks and repo-local config disabled.
# Build: make dev-agent-build
FROM debian:trixie-slim

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 10001 devagent \
    && useradd -u 10001 -g 10001 -M -d /tmp -s /usr/sbin/nologin devagent \
    && mkdir -p /workspace /out \
    && chown 10001:10001 /workspace /out

COPY --chmod=0755 handoff-bundle.sh /usr/local/bin/handoff-bundle

USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/handoff-bundle"]
