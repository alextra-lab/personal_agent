{
  "index_patterns": ["agent-captains-captures-*"],
  "priority": 110,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.codec": "best_compression",
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "dynamic_templates": [
        {
          "ms_fields_as_float": {
            "match_pattern": "regex",
            "match": "^(.*_ms|.*_seconds|.*_latency|.*_duration|.*_offset)$",
            "match_mapping_type": "*",
            "mapping": { "type": "float" }
          }
        },
        {
          "ids_keyword": {
            "match": "*_id",
            "match_mapping_type": "string",
            "mapping": { "type": "keyword" }
          }
        },
        {
          "enums_keyword": {
            "match_pattern": "regex",
            "match": "^(.*_type|.*_name|.*_role|.*_status|.*_decision|.*_strategy|.*_mode|.*_phase|.*_action|.*_kind|.*_state)$",
            "match_mapping_type": "string",
            "mapping": { "type": "keyword" }
          }
        },
        {
          "free_text": {
            "match_pattern": "regex",
            "match": "^(.*_message|.*_content|.*_description|reason|hint|stderr|stdout|raw_.*|.*_text|.*_prompt)$",
            "match_mapping_type": "string",
            "mapping": { "type": "text" }
          }
        },
        {
          "default_string_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "timestamp": { "type": "date" },
        "trace_id": { "type": "keyword" },
        "session_id": { "type": "keyword" },
        "entry_id": { "type": "keyword" },
        "type": { "type": "keyword" },
        "status": { "type": "keyword" },
        "title": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
        "rationale": { "type": "text" },
        "user_message": { "type": "text" },
        "assistant_response": { "type": "text" },
        "outcome": { "type": "keyword" },
        "tools_used": { "type": "keyword" },
        "duration_ms": { "type": "float" },
        "memory_context_used": { "type": "boolean" },
        "memory_conversations_found": { "type": "integer" },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "prompt_tokens": { "type": "integer" },
        "completion_tokens": { "type": "integer" },
        "user_id": { "type": "keyword" },
        "eval_mode": { "type": "boolean" },
        "proposed_change": {
          "properties": {
            "what": { "type": "text" },
            "why": { "type": "text" },
            "how": { "type": "text" }
          }
        },
        "supporting_metrics": { "type": "keyword" },
        "metrics_structured": {
          "type": "nested",
          "properties": {
            "name": { "type": "keyword" },
            "value": { "type": "float" },
            "unit": { "type": "keyword" }
          }
        },
        "metrics_summary": {
          "properties": {
            "cpu_avg": { "type": "float" },
            "cpu_max": { "type": "float" },
            "cpu_min": { "type": "float" },
            "memory_avg": { "type": "float" },
            "memory_max": { "type": "float" },
            "memory_min": { "type": "float" },
            "duration_seconds": { "type": "float" },
            "samples_collected": { "type": "integer" },
            "threshold_violations": { "type": "integer" }
          }
        },
        "telemetry_refs": {
          "type": "nested",
          "properties": {
            "trace_id": { "type": "keyword" },
            "metric_name": { "type": "keyword" },
            "value": { "type": "keyword" }
          }
        },
        "tool_results": {
          "type": "nested",
          "properties": {
            "tool_name": { "type": "keyword" },
            "success": { "type": "boolean" },
            "error": { "type": "text" },
            "latency_ms": { "type": "float" },
            "output": { "type": "text", "index": false },
            "arguments": { "type": "text", "index": false }
          }
        },
        "spec_task": { "type": "text" },
        "full_output": { "type": "text" },
        "injected_digest": { "type": "text" },
        "error": { "type": "text" },
        "truncation_ratio": { "type": "float" },
        "cost_usd": { "type": "float" },
        "context_messages": {
          "type": "nested",
          "properties": {
            "role": { "type": "keyword" },
            "chars": { "type": "integer" },
            "content_preview": { "type": "text" }
          }
        },
        "recall_admission": {
          "properties": {
            "state": { "type": "keyword" },
            "candidate_count": { "type": "integer" },
            "admitted_count": { "type": "integer" },
            "candidate_population": { "type": "keyword" },
            "items": {
              "type": "nested",
              "properties": {
                "kind": { "type": "keyword" },
                "identity": { "type": "keyword", "ignore_above": 1024 },
                "score": { "type": "float" },
                "admitted": { "type": "boolean" },
                "drop_reason": { "type": "keyword" }
              }
            }
          }
        },
        "assembled_context": {
          "properties": {
            "state": { "type": "keyword" },
            "message_count": { "type": "integer" },
            "system_prompt_chars": { "type": "integer" },
            "skill_bodies": { "type": "keyword", "ignore_above": 1024 },
            "memory_identities": { "type": "keyword", "ignore_above": 1024 },
            "primary_call_index": { "type": "integer" },
            "primary_call_count": { "type": "integer" },
            "conversation_slice": {
              "type": "nested",
              "properties": {
                "index": { "type": "integer" },
                "role": { "type": "keyword" },
                "origin_trace_id": { "type": "keyword" },
                "timestamp": { "type": "keyword" },
                "chars": { "type": "integer" }
              }
            }
          }
        },
        "evidence_presence": {
          "properties": {
            "user_message": { "type": "keyword" },
            "assistant_response": { "type": "keyword" },
            "reasoning_trace": { "type": "keyword" },
            "tool_calls": { "type": "keyword" },
            "recalled_memory": { "type": "keyword" },
            "assembled_context": { "type": "keyword" },
            "identifiers": { "type": "keyword" },
            "model_and_params": { "type": "keyword" }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Captain's Log capture docs (turn captures). Daily index agent-captains-captures-YYYY-MM-DD. Split out of the shared agent-captains-template in FRE-534/A2 so each doc shape (captures / reflections / subagents) owns non-colliding properties. metrics_summary.* pinned float/integer to defend against stray-0 type flips. FRE-1004 adds the ADR-0125 D3 turn-evidence records (recall_admission / assembled_context / evidence_presence), mapped explicitly rather than left to the root's dynamic:true so their fixed schemas cannot walk the field limit; conversation_slice.timestamp is keyword not date because it carries whatever the message was persisted with and a non-parsable value would reject the whole capture. Identity keywords carry ignore_above:1024 for the same fail-safe reason: an entity name is LLM-extracted and unbounded upstream, and a term over Lucene's 32766-byte limit rejects the ENTIRE capture document (reproduced against a live index), which would silently lose the whole turn's record while the disk copy survived. FRE-1060 adds recall_admission.candidate_population and widens recall_admission.items.drop_reason to cover the proactive path's own gates (recall_score_threshold / recall_candidate_cap / recall_item_cap / recall_score_floor / recall_score_gap / recall_item_oversized / recall_token_budget); drop_reason needed no mapping change, being an unrestricted keyword already. Additive only, no type change and no reindex. candidate_population is the read-side guard on a semantic change at that deploy: candidate_count previously counted post-selection survivors and now counts the offered population, so a record without the field (every capture written before FRE-1060) is survivors-only and must be read as post_selection. Pre- and post-deploy candidate-per-turn distributions are therefore NOT comparable; filter on candidate_population before aggregating across the boundary. candidate_population reads offered only where the producing path accounted for every candidate it discarded, which today is the proactive path alone; broad recall, entity match and the failure path stay post_selection because they truncate without reporting what they cut. No identity is ever recorded twice, so candidate_count minus admitted_count counts distinct memories. recall_admission.state is keyed on the candidates that reached context assembly rather than on items, so state empty and the evidence_presence.recalled_memory key derived from it keep their pre-FRE-1060 meaning of recall delivered nothing to the model even on turns whose entire population was gated away.",
    "managed_by": "scripts/setup-elasticsearch.sh"
  }
}
