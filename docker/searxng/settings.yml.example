# SearXNG configuration for personal agent (ADR-0034)
# Docs: https://docs.searxng.org/admin/settings/
#
# TEMPLATE. Copy to `settings.yml` and set your own Exa api_key:
#
#     cp docker/searxng/settings.yml.example docker/searxng/settings.yml
#
# The real `settings.yml` is gitignored (FRE-1310, mirrors the `budget.yaml`/
# FRE-1209 pattern): SearXNG's stock Docker image has no ${VAR}-style env
# substitution for settings.yml (confirmed against SearXNG's own docs), so an
# api_key literal is the only way to configure an engine — and this repo is
# public. Get the real key from the Exa dashboard, then:
#
#     pass show seshat/EXA_API_KEY
#
# and paste it over the `exa` engine's api_key placeholder below, flipping
# `disabled: false` to activate it.
#
# Everything else in this file (all other engines) carries no secrets and is
# just the working config, kept here as a complete, deployable template.
#
# THE ENGINE SET IS THIS FILE (FRE-1584). `use_default_settings` alone keeps every
# upstream engine the file does not remove. Before this change 90 engines were enabled
# and the file declared 28 of them, so 62 ran without being named. Among them were
# `google cse` (over quota, 257 of the 290 degraded searches in 14 days) and the news,
# image and video scrapers.
# `keep_only` below inverts that. An engine runs only if it is named there.
# Rule: keep an engine only when it calls a JSON or XML API. Engines that parse HTML
# pages are dropped. Three kept engines have a module that marks `use_official_api:
# False` — currency, chefkoch and mdn. They are kept on purpose: each answers only a
# query shape or an explicit category, and none appears in the 14-day failure reasons.
# To add an engine, add its name to `keep_only` AND an `engines:` block; then run
# `python -m scripts.monitors.searxng_engine_parity` against the running instance,
# which fails on a declared engine that did not load and on a running one not declared.

use_default_settings:
  engines:
    # Exactly the engines that run. Anything not named here is dropped, including the
    # upstream defaults that never appeared in this file. Dropped on purpose:
    #   scrapers   google, bing, duckduckgo, startpage, qwant, brave (HTML), every
    #              */news, */images, */videos variant, google scholar, lobste.rs, pypi
    #              (parses pypi.org/search HTML; fetch_url on pypi.org/pypi/<pkg>/json
    #              is the API route), reuters (site-internal endpoint)
    #   google cse an API engine, but over quota: "Suspended: too many requests"
    #   wikipedia  see the note where its block used to be
    #   helpers    dictzone, lingva, mymemory translated — query-triggered translators
    #              that rode along in `general`, not web search
    # ahmia, torch, wikidata, karmasearch*, reddit were removed individually before this
    # change because they failed to load in this image; `keep_only` makes that moot.
    keep_only:
      # general
      - braveapi
      - exa
      - currency   # a kept exception to the API rule — see the header and its block below
      # it
      - stackoverflow
      - github
      - hackernews
      - mdn
      - docker hub
      - huggingface
      - huggingface datasets
      - huggingface spaces
      # science
      - arxiv
      - semantic scholar
      - pubmed
      - crossref
      - openalex
      - openairepublications
      # news / social / recipes / weather
      - wikinews
      - lemmy posts
      - chefkoch
      - openmeteo
      - wttr.in

general:
  instance_name: "PersonalAgent Search"
  debug: false
  enable_metrics: true

search:
  safe_search: 0
  default_lang: "en"
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  secret_key: "personal-agent-searxng-secret-change-me-32chars"
  limiter: false
  public_instance: false

ui:
  default_theme: simple
  results_on_new_tab: false

engines:
  # ── General web search ──────────────────────────────────
  # Web search runs on braveapi + exa, two keyed API engines (FRE-1584). The scraped
  # engines that used to sit beside them were refused by this datacenter IP (CAPTCHA,
  # "access denied", "too many requests"); each refusal marked the whole search
  # degraded_retrieval. They are gone from this file, not switched off — see keep_only.

  # Brave runs its own 30B+ page index rather than proxying Google/Bing, so this is
  # `general`'s independent backbone. It is keyed, so it is not rate limited the way
  # scraping Brave from this IP was (that earned SearxEngineTooManyRequestsException).
  - name: braveapi
    engine: braveapi
    shortcut: bapi
    api_key: "REPLACE_WITH_BRAVE_API_KEY"
    results_per_page: 20
    # `inactive: false` is REQUIRED, not redundant with `disabled`. Upstream's own
    # defaults ship `braveapi` with `inactive: true`, and use_default_settings merges
    # by name — so without this the engine is silently never loaded, with no error.
    inactive: false
    disabled: false

  # `currency` answers "10 EUR in USD", which the web_search tool text promises. It calls
  # DuckDuckGo's undocumented JS endpoint (`use_official_api: False`), so it is one of
  # the three kept exceptions named in the header. It is kept because it is a
  # query-triggered converter, not a search engine, and it appears in none of the
  # 14-day failure reasons. Dropping it
  # costs currency conversion and nothing else: remove it from keep_only, delete this
  # block, and delete the example from tools/web.py. Categories are upstream's
  # (`general`, `currency`); they are deliberately not restated.
  - name: currency
    engine: currency_convert
    shortcut: cc

  # Wikipedia was removed (FRE-1584). Its engine uses the WHOLE query as a page title:
  # GET /api/rest_v1/page/summary/<quote(query)>. `quote` keeps "/" literal, so a query
  # containing a slash adds a path segment and Wikipedia answers 400; a "|" answers 500.
  # The engine swallows only the 400 whose detail is `title-invalid-characters`, so both
  # raise "HTTP error", and one unresponsive engine marks the whole search degraded.
  # Measured over 14 days: 28 of 482 searches (5.8%) — more than the 5% target by itself.
  # It is upstream code, so no setting here repairs it. It was also nearly redundant: a
  # sentence-shaped query is not a page title (404, handled), and brave/exa return
  # wikipedia.org pages themselves (38 of 482 searches). To restore it, add `wikipedia`
  # to keep_only, and expect "HTTP error" on slash or pipe queries.

  # ── IT / Development ────────────────────────────────────
  - name: stackoverflow
    shortcut: so
    disabled: false
    categories: it

  - name: github
    engine: github
    shortcut: gh
    disabled: false
    categories: it

  - name: mdn
    shortcut: mdn
    disabled: false
    categories: it

  - name: hackernews
    engine: hackernews
    shortcut: hn
    disabled: false
    categories: it

  - name: docker hub
    engine: docker_hub
    shortcut: dh
    disabled: false
    categories: it

  - name: huggingface
    engine: huggingface
    shortcut: hf
    disabled: false
    categories: it

  - name: huggingface datasets
    engine: huggingface
    huggingface_endpoint: datasets
    shortcut: hfd
    disabled: false
    categories: it

  - name: huggingface spaces
    engine: huggingface
    huggingface_endpoint: spaces
    shortcut: hfs
    disabled: false
    categories: it

  # ── Science / Research ──────────────────────────────────
  - name: arxiv
    engine: arxiv
    shortcut: ax
    disabled: false
    categories: science

  - name: semantic scholar
    engine: semantic_scholar
    shortcut: ss
    disabled: false
    categories: science

  - name: pubmed
    engine: pubmed
    shortcut: pm
    disabled: false
    categories: science

  - name: crossref
    engine: crossref
    shortcut: cr
    disabled: false
    categories: science

  - name: openalex
    engine: openalex
    shortcut: oa
    disabled: false
    categories: science

  - name: openairepublications
    shortcut: oap
    disabled: false
    categories: science

  # springer nature and astrophysics data system were declared here but NEVER loaded.
  # Upstream ships both `inactive: true` AND requiring an `api_key` we do not hold, and
  # `use_default_settings` merges by name, so our `disabled: false` was inherited over —
  # the same trap that silently disabled braveapi (FRE-1331). Re-add only with real keys,
  # and re-run scripts/monitors/searxng_engine_parity.py to prove they loaded.

  # ── News ────────────────────────────────────────────────
  # Only wikinews (MediaWiki API) remains. google/bing/duckduckgo/startpage/qwant/brave
  # news are scrapers and reuters calls a site-internal endpoint; all were refused or
  # erroring from this IP. For current events, use general (braveapi + exa).
  - name: wikinews
    shortcut: wn
    disabled: false
    categories: news

  # ── Social Media ─────────────────────────────────────────
  # reddit: engine removed upstream (engines/reddit.py absent as of 2026.8.29).
  #
  # `network: lemmy` is REQUIRED (FRE-1584). Upstream sets `lemmy posts` to share the
  # HTTP network of `lemmy communities`. keep_only drops `lemmy communities`, and a
  # `network:` that names a missing engine raises KeyError in searx/network/network.py
  # at startup — SearXNG then exits and web search is down, with no result to blame.
  # The `lemmy` network is defined under `outgoing.networks` below.
  - name: lemmy posts
    shortcut: lm
    disabled: false
    categories: social_media
    network: lemmy

  # ── Recipes ──────────────────────────────────────────────
  # chefkoch (api.chefkoch.de) is the only recipe engine upstream. FRE-796: it was once
  # tagged `general`, so every default web search returned German recipes for queries
  # containing words like "American". Scoped to its own category — reachable via
  # engines=chefkoch or categories=recipes.
  - name: chefkoch
    engine: chefkoch
    shortcut: ck
    disabled: false
    categories: recipes

  # ── Semantic search ─────────────────────────────────────
  # FRE-1310 shipped Exa in its own opt-in `exa` category, because it is a managed
  # third-party vendor that sees plaintext queries. The owner reversed that on
  # 2026-09-10: Exa joins `general`, so a default web_search reaches it, and it stays
  # reachable alone as categories=exa. Cost, measured 2026-10-11 with one probe call to
  # this exact payload: costDollars.total = $0.007 per search (10 results, highlights
  # at 2000 chars; highlights are not billed on top). At 1,420 searches in 30 days that
  # is about $9.94 per month.
  #
  # `weight: 3` ranks Exa above braveapi (implicit 1): Exa returns ~1,926 chars per
  # result against braveapi's ~217, measured on the same query.
  #
  # search_type pinned to `auto` — never `deep-reasoning`: that mode's output
  # is model-generated, not retrieval, and under the authorship-independence
  # rule (FRE-1303) that is not EXTERNAL, it's another model's assertion
  # wearing a retrieval's identifier.
  #
  # content_mode is `highlights`, not `text`: highlights are the query-relevant
  # excerpts and roughly 5x more token efficient, which matters because per-turn input
  # already reaches 83k on an ordinary research turn (FRE-1138). Never set this to
  # `text` without measuring the footprint (FRE-1331).
  - name: exa
    engine: exaapi
    shortcut: exa
    api_key: "REPLACE_WITH_EXA_API_KEY"
    results_per_page: 10
    search_type: auto
    content_mode: highlights
    content_max_characters: 2000
    categories: [general, exa]
    weight: 3
    # The TEMPLATE keeps shipping the pre-activation default, per its own contract and
    # test_exa_shipped_disabled_with_placeholder_key: activation (a real key plus
    # disabled: false) happens on the untracked settings.yml, never here. content_mode
    # and categories above are different in kind — they are policy, not activation, so
    # they belong in the template.
    disabled: true

  # ── Weather ─────────────────────────────────────────────
  # WeatherUnderground has no SearXNG engine. openmeteo is the best open-data
  # alternative with hyperlocal forecast data; wttr.in answers a JSON endpoint.
  - name: wttr.in
    engine: wttr
    shortcut: wttr
    disabled: false
    categories: weather

  - name: openmeteo
    engine: open_meteo
    shortcut: om
    disabled: false
    categories: weather

outgoing:
  # Own HTTP network for `lemmy posts` — see its block above.
  networks:
    lemmy: {}
  request_timeout: 8
  max_request_timeout: 15
  useragent_suffix: ""
  # Uncomment to route through a proxy:
  # proxies:
  #   all://:
  #     - socks5h://tor:9050
