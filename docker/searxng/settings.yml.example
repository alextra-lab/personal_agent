# SearXNG configuration for personal agent (ADR-0034)
# Docs: https://docs.searxng.org/admin/settings/
#
# TEMPLATE. Copy to `settings.yml` and set your own Exa api_key:
#
#     cp docker/searxng/settings.yml.example docker/searxng/settings.yml
#
# The real `settings.yml` is gitignored (FRE-1310, mirrors the `budget.yaml`/
# FRE-1209 pattern): SearXNG's stock Docker image has no ${VAR}-style env
# substitution for settings.yml (confirmed against SearXNG's own docs), so an
# api_key literal is the only way to configure an engine — and this repo is
# public. Get the real key from the Exa dashboard, then:
#
#     pass show seshat/EXA_API_KEY
#
# and paste it over the `exa` engine's api_key placeholder below, flipping
# `disabled: false` to activate it.
#
# Everything else in this file (all other engines) carries no secrets and is
# just the working config, kept here as a complete, deployable template.

use_default_settings:
  engines:
    # Completely remove engines that fail to load in this image build,
    # rather than just disabling them (disabled still triggers a load attempt).
    remove:
      - ahmia        # missing Tor/onion deps
      - torch        # missing sentence-transformers extras
      - wikidata     # SPARQL init fails due to upstream API change

general:
  instance_name: "PersonalAgent Search"
  debug: false
  enable_metrics: true

search:
  safe_search: 0
  default_lang: "en"
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  secret_key: "personal-agent-searxng-secret-change-me-32chars"
  limiter: false
  public_instance: false

ui:
  default_theme: simple
  results_on_new_tab: false

engines:
  # ── General web search ──────────────────────────────────
  - name: google
    engine: google
    shortcut: g
    disabled: false

  - name: brave
    engine: brave
    shortcut: br
    disabled: false

  - name: duckduckgo
    engine: duckduckgo
    shortcut: ddg
    disabled: false

  - name: wikipedia
    engine: wikipedia
    shortcut: wp
    disabled: false

  - name: startpage
    engine: startpage
    shortcut: sp
    disabled: false

  - name: qwant
    engine: qwant
    qwant_categ: web
    shortcut: qw
    categories: [general, web]
    disabled: false

  # ── IT / Development ────────────────────────────────────
  - name: stackoverflow
    shortcut: so
    disabled: false
    categories: it

  - name: github
    engine: github
    shortcut: gh
    disabled: false
    categories: it

  - name: mdn
    shortcut: mdn
    disabled: false
    categories: it

  - name: pypi
    engine: pypi
    shortcut: pypi
    disabled: false
    categories: it

  - name: hackernews
    engine: hackernews
    shortcut: hn
    disabled: false
    categories: it

  - name: lobste.rs
    shortcut: lo
    disabled: false
    categories: it

  - name: docker hub
    engine: docker_hub
    shortcut: dh
    disabled: false
    categories: it

  - name: huggingface
    engine: huggingface
    shortcut: hf
    disabled: false
    categories: it

  - name: huggingface datasets
    engine: huggingface
    huggingface_endpoint: datasets
    shortcut: hfd
    disabled: false
    categories: it

  - name: huggingface spaces
    engine: huggingface
    huggingface_endpoint: spaces
    shortcut: hfs
    disabled: false
    categories: it

  # ── Science / Research ──────────────────────────────────
  - name: arxiv
    engine: arxiv
    shortcut: ax
    disabled: false
    categories: science

  - name: semantic scholar
    engine: semantic_scholar
    shortcut: ss
    disabled: false
    categories: science

  - name: google scholar
    engine: google_scholar
    shortcut: gos
    disabled: false
    categories: science

  - name: pubmed
    engine: pubmed
    shortcut: pm
    disabled: false
    categories: science

  - name: crossref
    engine: crossref
    shortcut: cr
    disabled: false
    categories: science

  - name: openalex
    engine: openalex
    shortcut: oa
    disabled: false
    categories: science

  - name: openairepublications
    shortcut: oap
    disabled: false
    categories: science

  # ── News ────────────────────────────────────────────────
  - name: google news
    engine: google_news
    shortcut: gn
    disabled: false
    categories: news

  - name: bing news
    engine: bing_news
    shortcut: bn
    disabled: false
    categories: news

  - name: reuters
    engine: reuters
    shortcut: reu
    disabled: false
    categories: news

  - name: wikinews
    shortcut: wn
    disabled: false
    categories: news

  - name: qwant news
    engine: qwant
    qwant_categ: news
    shortcut: qwn
    categories: news
    network: qwant
    disabled: false

  # Note: google_news and bing_news validate language codes against internal
  # traits and do not support arbitrary locale overrides in settings.yml.
  # French press (LeMonde, Le Figaro, etc.) is surfaced via !qwn (Qwant News,
  # a French engine) and !gn / !bn when querying in French.
  # BBC / UK press is surfaced via !gn and !bn using English queries.

  # ── Social Media ─────────────────────────────────────────
  - name: reddit
    engine: reddit
    shortcut: re
    disabled: false
    categories: social_media

  - name: lemmy posts
    shortcut: lm
    disabled: false
    categories: social_media

  # ── Recipes ──────────────────────────────────────────────
  # Note: chefkoch is the primary recipe engine available in SearXNG.
  # For English recipes, use !g site:allrecipes.com or !g site:seriouseats.com
  # via the google engine — there is no dedicated English recipe engine upstream.
  # FRE-796: was tagged categories: general, so every default-category web
  # search included German recipe results (chefkoch titles loosely matched
  # unrelated queries containing words like "American"). Scoped to its own
  # category — still reachable via engines=chefkoch or categories=recipes.
  - name: chefkoch
    engine: chefkoch
    shortcut: ck
    disabled: false
    categories: recipes

  # ── Semantic search (opt-in) ────────────────────────────
  # FRE-1310. A dedicated `exa` category, NOT `general` — the owner has not
  # opted every query into a managed third-party vendor seeing plaintext
  # queries by default (SearXNG's other engines are self-hosted; Exa is not).
  # Reachable via engines=exaapi or categories=exa (see tools/web.py's tool
  # description for the model-facing framing).
  #
  # search_type pinned to `auto` — never `deep-reasoning`: that mode's output
  # is model-generated, not retrieval, and under the authorship-independence
  # rule (FRE-1303) that is not EXTERNAL, it's another model's assertion
  # wearing a retrieval's identifier.
  #
  # content_mode: text (not SearXNG's doc-page 'highlights' default) returns
  # full page text in one call, collapsing search-then-fetch and handing the
  # ADR-0138 grounding contract text to check containment against.
  # content_max_characters matches fetch_url's own _DEFAULT_MAX_CHARS
  # (tools/fetch.py) for consistency between the two full-text tools.
  #
  # Shipped disabled with a placeholder key — no live Exa key exists yet.
  # See the file header above for activation instructions.
  - name: exa
    engine: exaapi
    shortcut: exa
    api_key: "REPLACE_WITH_EXA_API_KEY"
    results_per_page: 10
    search_type: auto
    content_mode: text
    content_max_characters: 10000
    categories: exa
    disabled: true

  # ── Weather ─────────────────────────────────────────────
  # WeatherUnderground has no SearXNG engine. openmeteo is the
  # best open-data alternative with hyperlocal forecast data.
  - name: wttr.in
    engine: wttr
    shortcut: wttr
    disabled: false
    categories: weather

  - name: openmeteo
    engine: open_meteo
    shortcut: om
    disabled: false
    categories: weather

  # ── Additional Science ───────────────────────────────────
  - name: springer nature
    engine: springer
    shortcut: sn
    disabled: false
    categories: science

  - name: astrophysics data system
    engine: astrophysics_data_system
    shortcut: ads
    disabled: false
    categories: science


outgoing:
  request_timeout: 8
  max_request_timeout: 15
  useragent_suffix: ""
  # Uncomment to route through a proxy:
  # proxies:
  #   all://:
  #     - socks5h://tor:9050
