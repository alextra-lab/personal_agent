# SearXNG configuration for personal agent (ADR-0034)
# Docs: https://docs.searxng.org/admin/settings/
#
# TEMPLATE. Copy to `settings.yml` and set your own Exa api_key:
#
#     cp docker/searxng/settings.yml.example docker/searxng/settings.yml
#
# The real `settings.yml` is gitignored (FRE-1310, mirrors the `budget.yaml`/
# FRE-1209 pattern): SearXNG's stock Docker image has no ${VAR}-style env
# substitution for settings.yml (confirmed against SearXNG's own docs), so an
# api_key literal is the only way to configure an engine — and this repo is
# public. Get the real key from the Exa dashboard, then:
#
#     pass show seshat/EXA_API_KEY
#
# and paste it over the `exa` engine's api_key placeholder below, flipping
# `disabled: false` to activate it.
#
# Everything else in this file (all other engines) carries no secrets and is
# just the working config, kept here as a complete, deployable template.

use_default_settings:
  engines:
    # Completely remove engines that fail to load in this image build,
    # rather than just disabling them (disabled still triggers a load attempt).
    remove:
      - ahmia        # missing Tor/onion deps
      - torch        # missing sentence-transformers extras
      - wikidata     # SPARQL init fails due to upstream API change
      # Permanently 403 from this datacenter IP (2026-08-30). Removed rather than
      # disabled so they never appear in unresponsive_engines and desensitise
      # FRE-1339's degraded_retrieval signal.
      - karmasearch
      - karmasearch videos
      - karmasearch news
      # Removed upstream between 2026.4.17 and 2026.8.29 — engines/reddit.py no longer exists.
      - reddit

general:
  instance_name: "PersonalAgent Search"
  debug: false
  enable_metrics: true

search:
  safe_search: 0
  default_lang: "en"
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  secret_key: "personal-agent-searxng-secret-change-me-32chars"
  limiter: false
  public_instance: false

ui:
  default_theme: simple
  results_on_new_tab: false

engines:
  # ── General web search ──────────────────────────────────
  - name: google
    engine: google
    shortcut: g
    # Retired 2026-08-30: permanently blocked from this datacenter IP. `google cse`
    # (keyed) covers this slot. Left enabled it would trip degraded_retrieval forever.
    disabled: true

  - name: brave
    engine: brave
    shortcut: br
    disabled: true   # superseded by braveapi below (master 2026-08-30)

  # Added 2026-08-30 by master, owner-directed. The scraped `brave` engine above is
  # disabled in the same change: scraping Brave from this datacenter IP is what earned
  # the SearxEngineTooManyRequestsException suspensions, and a keyed call is not rate
  # limited the same way. Brave runs its own 30B+ page index rather than proxying
  # Google/Bing, so this is `general`'s independent backbone.
  - name: braveapi
    engine: braveapi
    shortcut: bapi
    api_key: "REPLACE_WITH_BRAVE_API_KEY"
    results_per_page: 20
    # `inactive: false` is REQUIRED, not redundant with `disabled`. Upstream's own
    # defaults ship `braveapi` with `inactive: true`, and use_default_settings merges
    # by name — so without this the engine is silently never loaded, with no error.
    inactive: false
    disabled: false

  # Added 2026-08-29 by master. `general` had exactly one working engine
  # (brave), so any single flap took web_search to zero results — measured at
  # 68% empty on 08-28 and 100% empty on 08-29. Bing answers fine from this IP
  # (verified: 10 results on four consecutive fresh queries) but was only
  # configured as `bing news` under categories: news, so it never served a
  # normal web search. This gives `general` a second working engine.
  - name: bing
    engine: bing
    shortcut: bi
    # Retired 2026-08-30: superseded by braveapi. Scraped bing answers this IP but
    # returns junk unrelated to the query — it was an emergency stopgap, not a search.
    disabled: true

  # Disabled 2026-08-29 by master — these refuse this VPS's datacenter IP and
  # will not recover by configuration. Measured via SearXNG's own
  # unresponsive_engines: duckduckgo "CAPTCHA", startpage "Suspended: CAPTCHA",
  # qwant "access denied". None has a public search API, so scraping is the only
  # route and it is the route being blocked. Left in the file rather than
  # deleted so the decision stays visible and is one-line reversible.
  - name: duckduckgo
    engine: duckduckgo
    shortcut: ddg
    disabled: true

  - name: wikipedia
    engine: wikipedia
    shortcut: wp
    disabled: false

  - name: startpage
    engine: startpage
    shortcut: sp
    disabled: true

  - name: qwant
    engine: qwant
    qwant_categ: web
    shortcut: qw
    categories: [general, web]
    disabled: true

  # ── IT / Development ────────────────────────────────────
  - name: stackoverflow
    shortcut: so
    disabled: false
    categories: it

  - name: github
    engine: github
    shortcut: gh
    disabled: false
    categories: it

  - name: mdn
    shortcut: mdn
    disabled: false
    categories: it

  - name: pypi
    engine: pypi
    shortcut: pypi
    disabled: false
    categories: it

  - name: hackernews
    engine: hackernews
    shortcut: hn
    disabled: false
    categories: it

  - name: lobste.rs
    shortcut: lo
    disabled: false
    categories: it

  - name: docker hub
    engine: docker_hub
    shortcut: dh
    disabled: false
    categories: it

  - name: huggingface
    engine: huggingface
    shortcut: hf
    disabled: false
    categories: it

  - name: huggingface datasets
    engine: huggingface
    huggingface_endpoint: datasets
    shortcut: hfd
    disabled: false
    categories: it

  - name: huggingface spaces
    engine: huggingface
    huggingface_endpoint: spaces
    shortcut: hfs
    disabled: false
    categories: it

  # ── Science / Research ──────────────────────────────────
  - name: arxiv
    engine: arxiv
    shortcut: ax
    disabled: false
    categories: science

  - name: semantic scholar
    engine: semantic_scholar
    shortcut: ss
    disabled: false
    categories: science

  - name: google scholar
    engine: google_scholar
    shortcut: gos
    disabled: false
    categories: science

  - name: pubmed
    engine: pubmed
    shortcut: pm
    disabled: false
    categories: science

  - name: crossref
    engine: crossref
    shortcut: cr
    disabled: false
    categories: science

  - name: openalex
    engine: openalex
    shortcut: oa
    disabled: false
    categories: science

  - name: openairepublications
    shortcut: oap
    disabled: false
    categories: science

  # ── News ────────────────────────────────────────────────
  - name: google news
    engine: google_news
    shortcut: gn
    disabled: false
    categories: news

  - name: bing news
    engine: bing_news
    shortcut: bn
    disabled: false
    categories: news

  - name: reuters
    engine: reuters
    shortcut: reu
    disabled: false
    categories: news

  - name: wikinews
    shortcut: wn
    disabled: false
    categories: news

  - name: qwant news
    engine: qwant
    qwant_categ: news
    shortcut: qwn
    categories: news
    network: qwant
    disabled: false

  # Note: google_news and bing_news validate language codes against internal
  # traits and do not support arbitrary locale overrides in settings.yml.
  # French press (LeMonde, Le Figaro, etc.) is surfaced via !qwn (Qwant News,
  # a French engine) and !gn / !bn when querying in French.
  # BBC / UK press is surfaced via !gn and !bn using English queries.

  # ── Social Media ─────────────────────────────────────────
  # reddit: engine removed upstream (engines/reddit.py absent as of 2026.8.29). Block
  # deleted 2026-08-30 — declaring it forced a failing load attempt and an ERROR at every
  # startup, which is exactly the noise that trains people to ignore startup errors.
  - name: lemmy posts
    shortcut: lm
    disabled: false
    categories: social_media

  # ── Recipes ──────────────────────────────────────────────
  # Note: chefkoch is the primary recipe engine available in SearXNG.
  # For English recipes, use !g site:allrecipes.com or !g site:seriouseats.com
  # via the google engine — there is no dedicated English recipe engine upstream.
  # FRE-796: was tagged categories: general, so every default-category web
  # search included German recipe results (chefkoch titles loosely matched
  # unrelated queries containing words like "American"). Scoped to its own
  # category — still reachable via engines=chefkoch or categories=recipes.
  - name: chefkoch
    engine: chefkoch
    shortcut: ck
    disabled: false
    categories: recipes

  # ── Semantic search (opt-in) ────────────────────────────
  # FRE-1310. A dedicated `exa` category, NOT `general` — the owner has not
  # opted every query into a managed third-party vendor seeing plaintext
  # queries by default (SearXNG's other engines are self-hosted; Exa is not).
  # Reachable via engines=exaapi or categories=exa (see tools/web.py's tool
  # description for the model-facing framing).
  #
  # search_type pinned to `auto` — never `deep-reasoning`: that mode's output
  # is model-generated, not retrieval, and under the authorship-independence
  # rule (FRE-1303) that is not EXTERNAL, it's another model's assertion
  # wearing a retrieval's identifier.
  #
  # content_mode: text (not SearXNG's doc-page 'highlights' default) returns
  # full page text in one call, collapsing search-then-fetch and handing the
  # ADR-0138 grounding contract text to check containment against.
  # content_max_characters matches fetch_url's own _DEFAULT_MAX_CHARS
  # (tools/fetch.py) for consistency between the two full-text tools.
  #
  # Shipped disabled with a placeholder key — no live Exa key exists yet.
  # See the file header above for activation instructions.
  # Activated 2026-08-30 by master, owner-directed. content_mode is `highlights`, not
  # `text`: highlights are the query-relevant excerpts and roughly 10x more token
  # efficient, which matters because per-turn input already reaches 83k on an ordinary
  # research turn (FRE-1138). Never set this to `text` without measuring the footprint.
  - name: exa
    engine: exaapi
    shortcut: exa
    api_key: "REPLACE_WITH_EXA_API_KEY"
    results_per_page: 10
    search_type: auto
    content_mode: highlights
    content_max_characters: 2000
    categories: exa
    disabled: false

  # ── Weather ─────────────────────────────────────────────
  # WeatherUnderground has no SearXNG engine. openmeteo is the
  # best open-data alternative with hyperlocal forecast data.
  - name: wttr.in
    engine: wttr
    shortcut: wttr
    disabled: false
    categories: weather

  - name: openmeteo
    engine: open_meteo
    shortcut: om
    disabled: false
    categories: weather

  # ── Additional Science ───────────────────────────────────
  - name: springer nature
    engine: springer
    shortcut: sn
    disabled: false
    categories: science

  - name: astrophysics data system
    engine: astrophysics_data_system
    shortcut: ads
    disabled: false
    categories: science


outgoing:
  request_timeout: 8
  max_request_timeout: 15
  useragent_suffix: ""
  # Uncomment to route through a proxy:
  # proxies:
  #   all://:
  #     - socks5h://tor:9050
